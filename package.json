{
  "name": "sceneweaver",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/index.mjs\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "vitest run src && node --test server/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.0",
    "ws": "^8.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanfel/SceneWeaver.git"
  },
  "bugs": {
    "url": "https://github.com/ethanfel/SceneWeaver/issues"
  },
  "homepage": "https://github.com/ethanfel/SceneWeaver#readme"
}
